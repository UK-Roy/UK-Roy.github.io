{% comment %}
  Project list cards (academic style)
  - Uses project front-matter: title, description, year, role, organization/grant, preview, report, video, github
  - Keeps "Read more" linking to the project page (detail page unchanged)
{% endcomment %}

{% assign projects = site.projects | sort: "year" | reverse %}

<div class="project-cards">
  {% for project in projects %}
    <div class="row project-card g-3">
      <!-- Left: preview image (optional) -->
      <div class="col-12 col-sm-3 col-md-2">
        {% if project.preview %}
          {% assign p = project.preview | prepend: '/assets/img/project_preview/' %}
          <div class="project-preview">
            {% include figure.liquid
              path=p
              sizes="220px"
              class="img-fluid rounded z-depth-1 project-preview-img"
              zoomable=false
              avoid_scaling=true
              alt=project.title
            %}
          </div>
        {% else %}
          <div class="project-preview project-preview--empty"></div>
        {% endif %}
      </div>

      <!-- Right: content -->
      <div class="col-12 col-sm-9 col-md-10">
        <!-- Title -->
        <div class="project-title">
          <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
        </div>

        <!-- Meta line (role || organization/grant || year) -->
        <div class="project-meta">
          {% assign meta_parts = "" | split: "|" %}

          {% if project.role %}
            {% assign meta_parts = meta_parts | push: project.role %}
          {% endif %}

          {% if project.organization %}
            {% assign meta_parts = meta_parts | push: project.organization %}
          {% elsif project.grant %}
            {% assign meta_parts = meta_parts | push: project.grant %}
          {% endif %}

          {% if project.year %}
            {% assign meta_parts = meta_parts | push: project.year %}
          {% endif %}

          {% if meta_parts.size > 0 %}
            {% for part in meta_parts %}
              <span class="project-meta-item">
                {% if forloop.first %}
                  <em>{{ part }}</em>
                {% else %}
                  {{ part }}
                {% endif %}
              </span>
              {% unless forloop.last %}
                <span class="project-meta-sep">||</span>
              {% endunless %}
            {% endfor %}
          {% endif %}
        </div>

        <!-- One-line description -->
        {% if project.description %}
          <div class="project-desc">
            {{ project.description }}
          </div>
        {% endif %}

        <!-- Buttons (clean academic) -->
        {% if project.report or project.video or project.github %}
           <div class="project-links mt-2">
  {% if project.report %}
    <a class="btn btn-sm btn-outline-primary me-2"
       href="{{ project.report }}" target="_blank" rel="noopener">
      Report
    </a>
  {% endif %}

  {% if project.video %}
    <a class="btn btn-sm btn-outline-primary me-2"
       href="{{ project.video }}" target="_blank" rel="noopener">
      Video
    </a>
  {% endif %}

  {% if project.github %}
    <a class="btn btn-sm btn-outline-primary"
       href="{{ project.github }}" target="_blank" rel="noopener">
      GitHub
    </a>
  {% endif %}

{% if project.website %}
    <a class="btn btn-sm btn-outline-primary" 
      href="{{ project.website }}" target="_blank" rel="noopener">
      Website
    </a>
  {% endif %}
</div>


        {% endif %}

        <!-- Read more -->
        <div class="project-more">
          <a href="{{ project.url | relative_url }}">Read more →</a>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
