{%- assign projects_sorted = site.projects | sort: "order" -%}

{%- assign research_projects = projects_sorted | where: "category", "research" -%}
{%- assign hobby_projects    = projects_sorted | where: "category", "hobby" -%}

<div class="project-cards">

  {% if research_projects and research_projects.size > 0 %}
    <h2 class="project-section-title">Research Projects</h2>
    <div class="project-section-divider"></div>

    {% for project in research_projects %}
      <div class="row project-card g-3">
        <!-- Left: preview image -->
        <div class="col-12 col-sm-3 col-md-2">
          {% if project.preview %}
            {% assign p = project.preview | prepend: '/assets/img/project_preview/' %}
            <div class="project-preview">
              {% include figure.liquid
                path=p
                sizes="220px"
                class="img-fluid rounded z-depth-1"
                zoomable=true
                avoid_scaling=true
                alt=project.title
              %}
            </div>
          {% endif %}
        </div>

        <!-- Right: content -->
        <div class="col-12 col-sm-9 col-md-10">
          <div class="project-title">
            <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
          </div>

          <!-- Meta: role || organization || year -->
          <div class="project-meta">
            {% assign parts = "" %}

            {% if project.role %}
              {% assign parts = parts | append: project.role %}
            {% endif %}

            {% if project.organization %}
              {% if parts != "" %}{% assign parts = parts | append: " || " %}{% endif %}
              {% assign parts = parts | append: project.organization %}
            {% endif %}

            {% if project.year %}
              {% if parts != "" %}{% assign parts = parts | append: " || " %}{% endif %}
              {% assign parts = parts | append: project.year %}
              {% if project.status %}
                {% assign parts = parts | append: " — " | append: project.status %}
              {% endif %}
            {% endif %}

            {{ parts }}
          </div>

          {% if project.description %}
            <div class="project-desc">{{ project.description }}</div>
          {% endif %}

          <div class="project-links">
            {% if project.report %}
              <a class="project-btn" href="{{ project.report }}" target="_blank" rel="noopener">Report</a>
            {% endif %}
            {% if project.video %}
              <a class="project-btn" href="{{ project.video }}" target="_blank" rel="noopener">Video</a>
            {% endif %}
            {% if project.github %}
              <a class="project-btn" href="{{ project.github }}" target="_blank" rel="noopener">Code</a>
            {% endif %}
            {% if project.website %}
              <a class="project-btn" href="{{ project.website }}" target="_blank" rel="noopener">Website</a>
            {% endif %}
          </div>

          <div class="project-more">
            <a href="{{ project.url | relative_url }}">Read more →</a>
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}


  {% if hobby_projects and hobby_projects.size > 0 %}
    <h2 class="project-section-title mt-5">Hobby Projects</h2>
    <div class="project-section-divider"></div>

    {% for project in hobby_projects %}
      <div class="row project-card g-3">
        <div class="col-12 col-sm-3 col-md-2">
          {% if project.preview %}
            {% assign p = project.preview | prepend: '/assets/img/project_preview/' %}
            <div class="project-preview">
              {% include figure.liquid
                path=p
                sizes="220px"
                class="img-fluid rounded z-depth-1"
                zoomable=true
                avoid_scaling=true
                alt=project.title
              %}
            </div>
          {% endif %}
        </div>

        <div class="col-12 col-sm-9 col-md-10">
          <div class="project-title">
            <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
          </div>

          <div class="project-meta">
            {% assign parts = "" %}

            {% if project.role %}
              {% assign parts = parts | append: project.role %}
            {% endif %}

            {% if project.organization %}
              {% if parts != "" %}{% assign parts = parts | append: " || " %}{% endif %}
              {% assign parts = parts | append: project.organization %}
            {% endif %}

            {% if project.year %}
              {% if parts != "" %}{% assign parts = parts | append: " || " %}{% endif %}
              {% assign parts = parts | append: project.year %}
              {% if project.status %}
                {% assign parts = parts | append: " — " | append: project.status %}
              {% endif %}
            {% endif %}

            {{ parts }}
          </div>

          {% if project.description %}
            <div class="project-desc">{{ project.description }}</div>
          {% endif %}

          <div class="project-links">
            {% if project.report %}
              <a class="btn btn-sm btn-outline-primary me-2" href="{{ project.report }}" target="_blank" rel="noopener">Report</a>
            {% endif %}
            {% if project.video %}
              <a class="btn btn-sm btn-outline-primary me-2" href="{{ project.video }}" target="_blank" rel="noopener">Video</a>
            {% endif %}
            {% if project.github %}
              <a class="btn btn-sm btn-outline-primary" href="{{ project.github }}" target="_blank" rel="noopener">Code</a>
            {% endif %}
            {% if project.website %}
              <a class="btn btn-sm btn-outline-primary" href="{{ project.website }}" target="_blank" rel="noopener">Website</a>
            {% endif %}
          </div>

          <div class="project-more">
            <a href="{{ project.url | relative_url }}">Read more →</a>
          </div>
        </div>
      </div>
    {% endfor %}
  {% endif %}

</div>
