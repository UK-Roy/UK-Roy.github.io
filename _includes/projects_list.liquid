{% assign projects = site.projects | sort: "year" | reverse %}

<div class="project-cards">
  {% for project in projects %}
    <div class="row project-card g-3">
      <!-- Left: preview image (optional) -->
      <div class="col-12 col-sm-3 col-md-2">
        {% if project.preview %}
          {% assign p = project.preview | prepend: '/assets/img/project_preview/' %}
          <div class="project-preview">
            {% include figure.liquid
              path=p
              sizes="220px"
              class="img-fluid rounded z-depth-1"
              zoomable=true
              avoid_scaling=true
              alt=project.title
            %}
          </div>
        {% endif %}
      </div>

      <!-- Right: content -->
      <div class="col-12 col-sm-9 col-md-10">
        <!-- Title -->
        <div class="project-title">
          <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
        </div>

        <!-- Meta line (role, grant, year) -->
        <div class="project-meta">
          {% if project.role %}<em>{{ project.role }}</em>{% endif %}
          {% if project.grant %}
            {% if project.role %} · {% endif %}
            <span class="project-grant">{{ project.grant }}</span>
          {% endif %}
          {% if project.year %}
            {% if project.role or project.grant %} · {% endif %}
            <span class="project-year">{{ project.year }}</span>
          {% endif %}
        </div>

        <!-- One-line description -->
        {% if project.description %}
          <div class="project-desc">
            {{ project.description }}
          </div>
        {% endif %}

        <!-- Buttons -->
        <div class="project-links">
          {% if project.report %}
            <a class="btn btn-sm btn-outline-primary" href="{{ project.report }}" target="_blank" rel="noopener">Report</a>
          {% endif %}
          {% if project.video %}
            <a class="btn btn-sm btn-outline-primary" href="{{ project.video }}" target="_blank" rel="noopener">Video</a>
          {% endif %}
          {% if project.github %}
            <a class="btn btn-sm btn-outline-primary" href="{{ project.github }}" target="_blank" rel="noopener">GitHub</a>
          {% endif %}
        </div>

        <!-- Read more -->
        <div class="project-more">
          <a href="{{ project.url | relative_url }}">Read more →</a>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
